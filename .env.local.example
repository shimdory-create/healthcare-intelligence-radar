DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
# Use the Transaction Pooler connection string (port 6543), not the direct
# connection (port 5432) — direct connections can fail DNS resolution on
# networks without IPv6 support. The pooler requires `prepare: false` in
# db.ts's postgres.js client config (already set) since PgBouncer
# transaction-mode pooling doesn't reliably support prepared statements.
CRON_SECRET=replace-with-a-random-string
